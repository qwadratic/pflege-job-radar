# Public read API (anon key is public by design; the dashboard ships with it)
SUPABASE_URL=https://klkxfvieaxpjlplloljn.supabase.co
SUPABASE_ANON_KEY=<anon key — public, read-only>

# Write path (keep secret). No Supabase service-role key anywhere -- the anon key already covers
# every read (public_read RLS) and the one direct PostgREST write (inbox); anything more privileged
# goes through this edge function and its own secret instead.
PFLEGE_INGEST_URL=https://klkxfvieaxpjlplloljn.supabase.co/functions/v1/pflege-ingest
PFLEGE_INGEST_SECRET=<ingest secret>

# Firecrawl /agent fallback for walled / unlabelled career sites (app + firecrawl_agent source)
FIRECRAWL_API_KEY=<fc-...>

# Optional: OpenAI-compatible LLM for CV refinement. Unset = keyword matching only.
#LLM_API_BASE=https://llm.int.exe.xyz/v1
#LLM_MODEL=gpt-5.4-mini

# /pro access -- comma-separated, case-insensitive (app/auth.py:owner_emails); defaults to a single hardcoded address if unset
OWNER_EMAILS=
