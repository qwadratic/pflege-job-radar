# Public read API (anon key is public by design; the dashboard ships with it)
SUPABASE_URL=https://klkxfvieaxpjlplloljn.supabase.co
SUPABASE_ANON_KEY=<anon key — public, read-only>

# Write path (keep secret). No Supabase service-role key anywhere -- the anon key already covers
# every read (public_read RLS) and the one direct PostgREST write (inbox); anything more privileged
# goes through this edge function and its own secret instead.
PFLEGE_INGEST_URL=https://klkxfvieaxpjlplloljn.supabase.co/functions/v1/pflege-ingest
PFLEGE_INGEST_SECRET=<ingest secret>

# Firecrawl /agent fallback for walled / unlabelled career sites (app + firecrawl_agent source)
FIRECRAWL_API_KEY=<fc-...>

# Optional: OpenAI-compatible LLM for CV refinement. Unset = keyword matching only.
#LLM_API_BASE=https://llm.int.exe.xyz/v1
#LLM_MODEL=gpt-5.4-mini

# /pro access -- comma-separated, case-insensitive (app/auth.py:owner_emails); defaults to a single hardcoded address if unset
OWNER_EMAILS=

# Inbound WhatsApp harness (app/wa, docs/whatsapp.md). Same names as the production bridge, so one
# Meta app covers both. Webhook needs app_secret + verify_token; sending needs token + phone id.
# WA_AUTOSEND unset = every reply is stored as a draft and nothing reaches Meta.
META_WHATSAPP_APP_SECRET=<meta app secret>
META_WHATSAPP_VERIFY_TOKEN=<any string, must match the Meta webhook form>
META_WHATSAPP_ACCESS_TOKEN=<system user token>
META_WHATSAPP_PHONE_NUMBER_ID=<phone number id>
#WA_AUTOSEND=1

# Which brain answers a turn: deterministic (default, no LLM) or luna (Claude-driven, same
# persona/gates as the reference this is adapted from -- app/wa/luna/VENDORED.md). The luna
# brain calls the `claude` CLI already authenticated on this host; it needs no separate key.
#WA_BRAIN=luna
#WA_LUNA_MODEL=claude-sonnet-5
#WA_LUNA_EFFORT=high

# Optional external clinic-contact CRM (app/wa/luna/external_contacts.py, TASK-69) -- a no-op
# unless WA_EXTERNAL_CONTACT_DB is set. If you run a separate contact CRM for your clinics, point
# this at its sqlite file (expected schema: companies/people/contact_channels -- see the module)
# so contacts.discover_contact() can prefer a real, role-classified contact over a website guess.
#WA_EXTERNAL_CONTACT_DB=/path/to/your/contact-crm.sqlite
#WA_EXTERNAL_CONTACT_READER=sudo sqlite3

# WhatsApp Cloud API's own 24h free-form messaging window (TASK-70) -- not this repo's choice.
# Outside it, only a template Meta has already approved can be sent; WA_REOPEN_TEMPLATE_NAME must
# name one you registered in Meta Business Manager, or a closed-window send fails loudly instead
# of silently trying free-form text (which Meta would reject) or doing nothing.
#WA_FREEFORM_WINDOW_HOURS=24
#WA_REOPEN_TEMPLATE_NAME=candidate_reopen_v1
#WA_REOPEN_TEMPLATE_LANG=de

# Per-candidate LLM call cap (TASK-76) -- a cost/abuse backstop, not a conversation throttle.
# 0 disables it. A thread whose ball has been on us longer than this many hours is flagged
# stuck_reply on GET /api/wa/threads (TASK-79).
#WA_LUNA_MAX_CALLS_PER_HOUR=20
#WA_STUCK_REPLY_HOURS=2

# Conversation ownership (app/wa/routing.py, TASK-75) -- routing a brand-new phone to "us" vs.
# leaving it with the real production system depends on knowing whether it is already a real-
# system candidate. Unset means that check cannot be made at all (a loud error, not a guess) for
# any phone that has not already been routed once. Point this at a plain, newline-delimited,
# periodically-synced export of phone numbers already known to the real system.
#WA_REAL_SYSTEM_PHONES_FILE=/path/to/known-real-system-phones.txt
# Produced periodically by app/wa/luna/export_known_phones.py (TASK-87, deploy/known-phones-export.*)
# -- generic, operator-configured (--db/--query), never a hardcoded schema. Not set here since
# both values are specific to the operator's own real system:
#KNOWN_PHONES_SOURCE_DB=/path/to/your/real-system.sqlite
#KNOWN_PHONES_SOURCE_QUERY=select phone_column from your_table

# Webhook router (app/wa/router.py, TASK-84) -- where to forward a "them"-owned message. This
# repo does not register POST /api/wa/route-webhook as Meta's actual webhook URL anywhere; that
# is a separate, external, explicitly-confirmed production change.
#WA_REAL_SYSTEM_WEBHOOK_URL=https://real-system.example/webhook

# Proactive follow-up nudges (app/wa/luna/followups.py, TASK-85) -- tiered re-engagement for a
# candidate who went silent after our last message, capped per streak.
#WA_FOLLOWUP_TIERS_MINUTES=15,60,240
#WA_MAX_FOLLOWUPS_PER_STREAK=4
#WA_FOLLOWUP_NUDGE_DE=Nur zur Sicherheit nachgefragt – sind Sie noch da?
