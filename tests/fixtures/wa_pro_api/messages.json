      {
        "at": "2026-09-18T09:00:00+00:00",
        "body": "Guten Tag, ich bin examinierte Pflegefachkraft und suche eine Stelle in Schwaben.",
        "deleted": false,
        "direction": "in",
        "id": 4,
        "kind": "text",
        "meta": {},
        "status": null
      },
      {
        "at": "2026-09-18T09:05:00+00:00",
        "body": "Schoen, dass Sie sich melden! Haben Sie schon eine Anerkennungs-Urkunde?",
        "deleted": false,
        "direction": "out",
        "id": 5,
        "kind": "text",
        "meta": {},
        "status": null
      },
      {
        "at": "2026-09-19T10:00:00+00:00",
        "body": "Meine Urkunde liegt schon vor, ich arbeite auf der Intensivstation.",
        "deleted": false,
        "direction": "in",
