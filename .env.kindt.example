# .env template for kindt (partner's external review/crawl agent, runs off this VM)
# Fill placeholders yourself before handing off. Public domains only -- nothing here is
# the exe.dev internal proxy (*.int.exe.xyz), so it all works from a machine outside this VM.

# App API -- our own code + Firecrawl-backed crawling, live board, run status. No auth for reads.
PFLEGE_BOARD_API=https://pflege-board.exe.xyz/api

# Agent key -- unlocks ONLY POST /api/crawl, /api/inbox/drain, /api/clinics/{id}/refetch-career
# (docs/auth.md "Agent API key"). Minted with `PUT /api/settings/agent-key`, shown once at mint
# time, only its hash is ever stored -- ask for a fresh one if this is lost, it cannot be re-read.
AGENT_API_KEY=<paste the value PUT /api/settings/agent-key returned>

# Supabase -- exe.dev-hosted project; official public domain, read-only anon key
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key -- public, read-only>

# Optional: your own Firecrawl/Exa keys, only if kindt runs its own crawl instead of firing ours
# via PFLEGE_BOARD_API above. Results still land through POST {SUPABASE_URL}/rest/v1/inbox (anon
# key only, no secret needed) + POST {PFLEGE_BOARD_API}/inbox/drain (agent key) to get classified.
#FIRECRAWL_API_KEY=<fc-...>
#EXA_API_KEY=<exa key>

# Optional: OpenAI-compatible LLM for CV refinement. Unset = keyword matching only.
#LLM_API_BASE=https://api.openai.com/v1
#LLM_MODEL=gpt-5.4-mini
