# secrets
.env
.env.*
!.env.example
!.env.kindt.example
# the real client identity (name, mail domains); see config/wa-client.example.json -- this repo is
# public and TASK-162 says the client's name is never committed here
config/wa-client.json
# real WhatsApp test-handset numbers (Ivan/Valentyn); see config/wa-test-numbers.example.json
config/wa-test-numbers.json
config/wa-test-numbers-reset.csv
# same reason -- old recipient-file location, kept gitignored so an existing local copy on a
# checkout that has not moved to config/wa-test-numbers.json yet stays untracked
data/uat-*
# public build config (project URL + anon key, both public by design) -- needed to reproduce the build
!web/.env.build

# crawler output + backups (large, regenerable)
crawl_output/
crawl_indeed/
crawl_portals/
crawl_ats2/
crawl_vendors/
crawl_vendors.log
crawl_raw/
crawl_snapshots/
backups/
data/export/

# the hosted zip is replaced by this repo
web/pflege_jobs_repo.zip

# source PDF (3.6 MB, re-downloadable from stmgp.bayern.de; see data/registry/README.md)
*.pdf

# build/deploy leftovers
.netlify/
web/.netlify/
web/netlify/
node_modules/

# python
__pycache__/
*.py[cod]
.pytest_cache/
*.bak

# run artefacts (regenerable outputs of a pipeline run, not source)
data/*.log
data/verify.json
data/compare_*.json
data/clinic_links.json
data/cross_merge_pairs.json

# app state (SQLite) — regenerable
data/app.sqlite*
data/autopilot.sqlite*
# WhatsApp threads (app/wa) — NOT regenerable, and holds lead phone numbers: never commit it
data/wa.sqlite*
# Claude Code session transcripts for WA_BRAIN=luna (app/wa/luna_brain.py) -- one per WhatsApp
# thread, holds the real conversation once live: never commit it, same reason as wa.sqlite above
data/wa_luna_sessions/
# Original files candidates send over WhatsApp (CV, Urkunde, photos; app/wa/api.py:_store_original,
# TASK-95) -- real candidate PII: never commit it
data/wa_documents/
# Phones known to the old system (export_known_phones.py, rewritten hourly by known-phones-export.timer,
# docs/rollout-runbook.md) -- real phone numbers: never commit it
data/known-real-system-phones.txt
# the raw crawler queue (TASK-95): local, large, and the only copy of rows nobody re-crawls
data/inbox.sqlite*
.venv/
*.log

# judge runner state (queue/mr files are written by the scheduled routines, not committed)
.judge/*
!.judge/config.json

# UI eval recordings (tools/uieval.py) -- regenerable, and deliberately outside web/ so they are
# never served: web/skill/ is public and unauthenticated
eval_out/

# hunter single-instance lock + stop file
data/hunter.lock
data/HUNTER_STOP

# agent-tool isolated worktree checkouts (ephemeral, each on its own branch already)
.claude/worktrees/

# synthetic E2E funnel test report (tests/test_wa_luna_e2e_funnel.py) -- regenerated each real run
tests/.artifacts/

supabase/.temp/

# TASK-120: collected clinic photos (large, regenerable via tools/task120_collect_clinic_photos.py) --
# the served copies live under data/clinic_photos/<id>/, indexed by the clinic_photos sqlite table
data/clinic_photos/
data/clinic_photos.zip

# Real mailbox material and rehearsal/test artefacts. `git add -A` swept these into a release
# commit on 2026-09-23 -- 300k lines of real candidate and clinic correspondence, caught and
# reverted before it was pushed. They are dumps and working files, not source; nothing rebuilds
# from the repo copy.
data/email-dump/
data/email-analysis/
data/docs-site/
data/wa_test_docs/
data/wa_rehearsal.sqlite
