# secrets
.env
.env.*
!.env.example
!.env.kindt.example
# public build config (project URL + anon key, both public by design) -- needed to reproduce the build
!web/.env.build

# crawler output + backups (large, regenerable)
crawl_output/
crawl_indeed/
crawl_portals/
crawl_ats2/
crawl_vendors/
crawl_vendors.log
crawl_raw/
crawl_snapshots/
# the local mirror of the clinic sites (tests/mirror.py, tools/mirror.py): third-party pages with HR names, e-mails and
# phone numbers -- never committed, the repo is public
data/mirror/
# ...except the two infra snapshots (web fonts, registry read proxy; headers cut, ~0.07 MB) in tests/fixtures/mirror_infra/: committed,
# but the .prev a re-record leaves beside them is not
tests/fixtures/mirror_infra/*.prev*
tests/fixtures/mirror_infra/*.tmp
backups/
data/export/

# the hosted zip is replaced by this repo
web/pflege_jobs_repo.zip

# source PDF (3.6 MB, re-downloadable from stmgp.bayern.de; see data/registry/README.md)
*.pdf

# build/deploy leftovers
.netlify/
web/.netlify/
web/netlify/
node_modules/

# python
__pycache__/
*.py[cod]
.pytest_cache/
*.bak

# run artefacts (regenerable outputs of a pipeline run, not source)
data/*.log
data/verify.json
data/compare_*.json
data/clinic_links.json
data/cross_merge_pairs.json

# app state (SQLite) — regenerable
data/app.sqlite*
data/autopilot.sqlite*
# the raw crawler queue (TASK-95): local, large, and the only copy of rows nobody re-crawls
data/inbox.sqlite*
.venv/
*.log

# judge runner state (queue/mr files are written by the scheduled routines, not committed)
.judge/*
!.judge/config.json

# UI eval recordings (tools/uieval.py) -- regenerable, and deliberately outside web/ so they are
# never served: web/skill/ is public and unauthenticated
eval_out/

# hunter single-instance lock + stop file
data/hunter.lock
data/HUNTER_STOP
supabase/.temp/

# TASK-120: collected clinic photos (large, regenerable via tools/task120_collect_clinic_photos.py) --
# the served copies live under data/clinic_photos/<id>/, indexed by the clinic_photos sqlite table
data/clinic_photos/
data/clinic_photos.zip
