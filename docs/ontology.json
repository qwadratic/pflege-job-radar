 "process": {
  "steps": [
   {
    "id": "parse_pdf",
    "title": {
     "de": "PDF parsen",
     "en": "Parse the PDF"
    },
    "desc": {
     "de": "Der Krankenhausplan wird zu 407 Standorten (KeZ, Betten, Fachrichtungen, Träger); die Legende wird taxonomy.json.",
     "en": "The hospital plan becomes 407 sites (KeZ, beds, departments, operator); the legend becomes taxonomy.json."
    },
    "nodes": [
     "krankenhausplan_pdf",
     "clinics",
     "taxonomy_json"
    ],
    "edges": [
     [
      "krankenhausplan_pdf",
