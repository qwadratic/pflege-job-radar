{
  "nodes": [
    {"id": "krankenhausplan_pdf", "label": "Krankenhausplan Bayern 2026 (PDF)", "kind": "external", "desc": "Official StMGP register, 51. Fortschreibung. Source of truth for hospital identity.", "fields": ["KeZ", "name", "town", "Träger", "Trägerschaft", "Versorgungsstufe", "Betten", "Plätze", "Fachrichtungen"]},
    {"id": "ats_boards", "label": "ATS boards / career sites", "kind": "external", "desc": "Hospital career portals: softgarden, B-ITE, rexx, umantis, mein-check-in, typo3_jobs, concludis, P&I, personio …", "fields": ["JSON-LD JobPosting", "vendor feed / API", "HTML list + detail"]},
    {"id": "firecrawl_agent", "label": "Firecrawl /agent", "kind": "external", "desc": "LLM browsing agent, used only for walled / unlabeled / dead sites. Credit-capped per call.", "fields": ["prompt", "schema", "maxCredits", "creditsUsed"]},
    {"id": "taxonomy_json", "label": "taxonomy.json", "kind": "file", "desc": "Fachrichtungen codes, Versorgungsstufe, Trägerart, status, size buckets, ats_type labels.", "fields": ["fachrichtungen", "versorgungsstufe", "traegerart", "status", "size_buckets", "ats_types"]},
    {"id": "patterns_json", "label": "patterns.json", "kind": "file", "desc": "Every regex the pipeline uses: employer class, role class, department, enrichment, CV skills. Editable in Settings.", "fields": ["employer", "role", "qualification", "department", "enrichment", "cv"]},
    {"id": "app_sqlite", "label": "app.sqlite", "kind": "file", "desc": "Backend state: crawl runs, logs, career profiles, schedule, firecrawl usage.", "fields": ["crawl_runs", "run_log", "career_profiles", "settings", "firecrawl_usage"]},
    {"id": "sources", "label": "sources", "kind": "table", "desc": "Provenance + precedence. Lower wins.", "fields": ["source_id", "code", "kind", "precedence"]},
    {"id": "clinics", "label": "clinics", "kind": "table", "desc": "One row per hospital site, keyed by KeZ. Registry columns from the PDF, routing columns from discovery.", "fields": ["clinic_id (KeZ)", "name", "town", "operator", "landkreis", "regierungsbezirk", "status", "versorgungsstufe", "traegerart", "beds", "day_places", "fachrichtungen", "website", "careers_url", "ats_type", "employer_id"]},
    {"id": "employers", "label": "employers", "kind": "table", "desc": "Employer identity as written on postings, classified clinic / unknown / non_clinic.", "fields": ["employer_id", "name_norm", "name_display", "employer_class", "class_rule", "class_source"]},
    {"id": "inbox", "label": "inbox", "kind": "table", "desc": "Raw crawler rows, one shape for every crawler.", "fields": ["kind", "source_host", "source_url", "payload", "collector", "client_id", "process_note"]},
    {"id": "posting_observations", "label": "posting_observations", "kind": "table", "desc": "One row per sighting of a job in one source. The evidence.", "fields": ["observation_id", "source_id", "source_ref", "source_url", "posting_id", "observed_at", "title", "role_class", "role_rule", "city", "description", "payload"]},
    {"id": "postings", "label": "postings", "kind": "table", "desc": "One row per real-world vacancy, fields resolved by precedence. The answer.", "fields": ["posting_id", "title", "employer_id", "clinic_id", "clinic_match_rule", "role_class", "department_hint", "city", "plz", "lat", "lon", "employment_types", "contract", "first_published", "last_seen", "status", "verify_status", "enr_*", "provenance", "n_observations"]},
    {"id": "role_classes", "label": "role_classes", "kind": "table", "desc": "Role taxonomy + default tariff grades.", "fields": ["role_class", "label_de", "label_en", "is_pflege", "tvoed_p_grade", "tv_l_kr_grade"]},
    {"id": "crawl_runs", "label": "crawl_runs", "kind": "table", "desc": "Run log per source / scope.", "fields": ["run_id", "source_id", "started_at", "finished_at", "n_fetched", "n_new", "slice_counts", "notes"]},
    {"id": "v_postings", "label": "v_postings", "kind": "view", "desc": "postings ⋈ employers ⋈ role_classes ⋈ clinics + source_codes/source_url. Default read relation.", "fields": ["all posting columns", "employer", "employer_class", "clinic_name", "regierungsbezirk", "versorgungsstufe", "traegerart", "clinic_beds", "source_codes", "source_url"]},
    {"id": "v_clinics", "label": "v_clinics", "kind": "view", "desc": "clinics + open/live nursing posting counts.", "fields": ["clinic_id", "open_pflege_postings", "open_pflege_live", "employer_names"]},
    {"id": "v_clinic_portals", "label": "v_clinic_portals", "kind": "view", "desc": "clinic → website, careers_url, ats_type, has_live_site_source.", "fields": ["clinic_id", "website", "careers_url", "ats_type", "has_live_site_source", "open_pflege_live"]},
    {"id": "classify", "label": "classify", "kind": "process", "desc": "patterns.json → employer_class, role_class, department_hint, qualification_hint, enr_*; rule that fired is stored.", "fields": ["classify_employer", "classify_role", "enrich_description"]},
    {"id": "resolve", "label": "resolve_postings()", "kind": "process", "desc": "Link observations to postings by fuzzy_key, rebuild golden fields by precedence.", "fields": ["fuzzy_key", "precedence", "provenance"]},
    {"id": "link_clinics", "label": "link-clinics", "kind": "process", "desc": "Attach postings to a KeZ: 6 ordered rules (exact name → operator+town).", "fields": ["R1..R6", "clinic_match_rule", "clinic_match_score"]},
    {"id": "verify", "label": "verify", "kind": "process", "desc": "HTTP re-fetch of source_url: live / gone / blocked / error. gone → expired.", "fields": ["verify_status", "verify_http", "verified_at"]}
  ],
