     [
      "krankenhausplan_pdf",
      "taxonomy_json"
     ]
    ]
   },
   {
    "id": "discover_ats",
    "title": {
     "de": "Portale erkennen",
     "en": "Discover portals"
    },
    "desc": {
     "de": "Für jeden Standort: Website → Karriereseite → ATS-Fingerabdruck. Ergebnis in clinics.careers_url / ats_type = die Route. Ohne Treffer hilft der Firecrawl-Agent (Portal-Erkennung).",
     "en": "Per site: website → careers page → ATS fingerprint. Result in clinics.careers_url / ats_type = the route. Without a hit the Firecrawl agent discovers the portal."
    },
    "nodes": [
     "clinics",
     "ats_boards",
     "firecrawl_agent"
    ],
    "edges": [
     [
      "clinics",
      "ats_boards"
     ],
     [
      "firecrawl_agent",
      "clinics"
     ]
    ]
   },
   {
    "id": "fetch_boards",
    "title": {
     "de": "Boards lesen (Adapter)",
     "en": "Read boards (adapters)"
    },
    "desc": {
     "de": "Ein Board ist die Arbeitseinheit, nicht der Standort: geteilte Boards werden einmal geholt. Adapter liefern Zeilen in der einen inbox-Form.",
     "en": "The board is the unit of work, not the site: shared boards are fetched once. Adapters emit rows in the single inbox shape."
    },
    "nodes": [
     "ats_boards",
     "inbox",
     "app"
    ],
    "edges": [
     [
      "ats_boards",
      "inbox"
     ],
     [
      "app",
      "ats_boards"
     ]
    ]
   },
   {
    "id": "firecrawl_fallback",
    "title": {
     "de": "Firecrawl-Fallback",
     "en": "Firecrawl fallback"
    },
    "desc": {
     "de": "Ohne Adapter, hinter Bot-Wand oder JS-only: der Agent liest das Portal mit Schema und Credit-Deckel und liefert dieselben inbox-Zeilen (Quelle 25).",
     "en": "No adapter, bot wall or JS-only: the agent reads the portal with a schema and a credit cap and emits the same inbox rows (source 25)."
    },
    "nodes": [
     "firecrawl_agent",
     "inbox",
     "app_sqlite"
    ],
    "edges": [
     [
      "firecrawl_agent",
      "inbox"
     ],
     [
      "firecrawl_agent",
      "app_sqlite"
     ],
     [
